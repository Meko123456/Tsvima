<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's background for the picker's preview layout: the theme's widget background,
     rounded to the launcher's widget radius as RainCard rounds it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_background" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
